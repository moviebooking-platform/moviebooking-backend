# Movie Ticket Booking System

# Application
NODE_ENV=development
PORT=3000

# Database (SQL Server)
DB_HOST=localhost
DB_PORT=1433
DB_USERNAME=sa
DB_PASSWORD=
DB_DATABASE=moviebooking_db

# Initial Admin (for migration seeding)
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@moviebooking.com
ADMIN_PASSWORD=

# JWT 
JWT_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# ID Encryption
ID_ENCRYPTION_KEY=

# Service Ports
IDENTITY_SERVICE_PORT=3001
THEATRE_SERVICE_PORT=3002
MOVIE_SERVICE_PORT=3003
SHOW_SERVICE_PORT=3004
BOOKING_SERVICE_PORT=3005

# Inter-Service URLs
THEATRE_SERVICE_URL=http://localhost:3002
MOVIE_SERVICE_URL=http://localhost:3003
SHOW_SERVICE_URL=http://localhost:3004
BOOKING_SERVICE_URL=http://localhost:3005

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_BOOKING_EXCHANGE=booking.events

# Booking Service configuration
HOLD_LIFETIME_MINUTES=5
PAYMENT_WINDOW_MINUTES=10
MAX_RESERVATION_MINUTES=15
SEAT_LOCK_TTL_SECONDS=8
SEAT_LOCK_WAIT_MS=500
MAX_SEATS_PER_BOOKING=10
BOOKING_REF_MAX_RETRIES=3

